<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true" />

    <RelativeLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <View
            android:id="@+id/drop_shadow_top"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_alignParentTop="true"
            android:background="@drawable/ayp_drop_shadow_top" />

        <View
            android:id="@+id/drop_shadow_bottom"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/ayp_drop_shadow_bottom" />


        <TextView
            android:id="@+id/video_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="64dp"
            android:layout_marginTop="12dp"
            android:layout_toStartOf="@+id/extra_views_container"
            android:ellipsize="end"
            android:lines="2"
            android:padding="@dimen/ayp_8dp"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/extra_views_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="32dp"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/cc_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ayp_icon_background_with_ripple"
                android:clickable="true"
                android:contentDescription="CC"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ayp_ic_cc_off"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ayp_icon_background_with_ripple"
                android:clickable="true"
                android:contentDescription="Settings"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ayp_ic_settings"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/play_pause_button"
            android:layout_width="@dimen/ayp_icon_size"
            android:layout_height="@dimen/ayp_icon_size"
            android:layout_centerInParent="true"

            android:background="@drawable/ayp_icon_background_with_ripple"

            android:clickable="true"
            android:contentDescription="@string/ayp_play_button"
            android:focusable="true"
            android:padding="@dimen/ayp_icon_padding"

            android:src="@drawable/ayp_ic_play_36dp"
            android:visibility="invisible" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="bottom"
            android:orientation="vertical">

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.customui.views.YouTubePlayerSeekBar
                android:id="@+id/youtube_player_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="100dp"
                app:color="@color/ayp_red"
                app:fontSize="12sp" />

            <RelativeLayout
                android:id="@+id/bottom_actions_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/live_video_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:text="@string/ayp_live"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone" />


                <!-- Right: "Video khác" + fullscreen -->
                <LinearLayout
                    android:id="@+id/right_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/more_video_container"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/ayp_background_rounded_rect_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Video khác"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/more_video_button"
                            android:layout_width="48dp"
                            android:layout_height="27dp"
                            android:clickable="false"
                            android:contentDescription="Next Video Thumbnail"
                            android:focusable="false"
                            android:scaleType="centerCrop"
                            android:layout_marginStart="8dp"
                            android:src="@android:color/darker_gray"
                            android:visibility="visible" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/youtube_button"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ayp_icon_background_with_ripple"
                        android:clickable="false"
                        android:contentDescription="@string/ayp_open_video_in_youtube"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ayp_ic_youtube_24dp"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/fullscreen_button"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/ayp_icon_background_with_ripple"
                        android:clickable="true"
                        android:contentDescription="@string/ayp_full_screen_button"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ayp_ic_fullscreen_24dp" />

                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>

        <!-- Forward/Rewind Feedback Views -->
        <LinearLayout
            android:id="@+id/rewind_feedback_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="40dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/ayp_background_rounded_36"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ayp_ic_skip_back"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 seconds"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forward_feedback_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/ayp_background_rounded_36"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ayp_ic_skip_forward"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 seconds"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/custom_action_left_button"
            android:layout_width="@dimen/ayp_icon_size"
            android:layout_height="@dimen/ayp_icon_size"
            android:layout_centerVertical="true"

            android:layout_margin="32dp"

            android:layout_toStartOf="@+id/play_pause_button"
            android:background="@drawable/ayp_icon_background_with_ripple"

            android:clickable="true"
            android:contentDescription="@string/ayp_custom_action_left"
            android:focusable="true"
            android:padding="@dimen/ayp_icon_padding"

            android:src="@drawable/ayp_ic_skip_back"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/custom_action_right_button"
            android:layout_width="@dimen/ayp_icon_size"
            android:layout_height="@dimen/ayp_icon_size"
            android:layout_centerVertical="true"

            android:layout_margin="32dp"

            android:layout_toEndOf="@+id/play_pause_button"
            android:background="@drawable/ayp_icon_background_with_ripple"

            android:clickable="true"
            android:contentDescription="@string/ayp_custom_action_right"
            android:focusable="true"

            android:padding="@dimen/ayp_icon_padding"
            android:src="@drawable/ayp_ic_skip_forward"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/lock_button"
            android:layout_width="@dimen/ayp_icon_size"
            android:layout_height="@dimen/ayp_icon_size"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="24dp"
            android:background="@drawable/ayp_icon_background_with_ripple"
            android:clickable="true"
            android:contentDescription="@string/ayp_open_video_in_youtube"
            android:focusable="true"
            android:padding="@dimen/ayp_icon_padding"
            android:src="@drawable/ayp_ic_lock"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/arrow_down_button"
            android:layout_width="@dimen/ayp_icon_size"
            android:layout_height="@dimen/ayp_icon_size"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/ayp_8dp"
            android:layout_marginTop="@dimen/ayp_12sp"
            android:background="@drawable/ayp_icon_background_with_ripple"
            android:clickable="true"
            android:contentDescription="@string/ayp_play_button"
            android:focusable="true"
            android:padding="@dimen/ayp_icon_padding"
            android:src="@drawable/ayp_ic_arrow_down" />

    </RelativeLayout>

    <!-- Volume/Brightness Overlay Indicator -->
    <LinearLayout
        android:id="@+id/volume_brightness_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/ayp_background_rounded_36"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/vb_overlay_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ayp_ic_play_36dp"
            android:tint="@android:color/white" />

        <ProgressBar
            android:id="@+id/vb_overlay_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="100dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50"
            android:progressTint="@android:color/white"
            android:progressBackgroundTint="#88FFFFFF" />

        <TextView
            android:id="@+id/vb_overlay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="50%"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>